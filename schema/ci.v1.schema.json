{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://boundry.company/schemas/ci/v1.json",
  "title": "Boundry CI pipeline definition (.boundry/ci.yaml), version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "jobs"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "on": { "$ref": "#/definitions/triggers" },
    "concurrency": { "$ref": "#/definitions/concurrency" },
    "defaults": { "$ref": "#/definitions/jobFields" },
    "templates": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/identifier" },
      "additionalProperties": { "$ref": "#/definitions/jobFields" }
    },
    "downstream": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository"],
        "properties": {
          "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "ref": { "type": "string" },
          "when": { "$ref": "#/definitions/when" }
        }
      }
    },
    "jobs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/definitions/identifier" },
      "additionalProperties": { "$ref": "#/definitions/job" }
    }
  },
  "definitions": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "capability": {
      "enum": ["linux-small", "linux-build", "linux-browser", "linux-arm64", "macos-arm64", "macos-x64", "release", "deploy"]
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "push": { "$ref": "#/definitions/refFilter" },
        "pull_request": { "$ref": "#/definitions/refFilter" },
        "tag": {
          "type": "object", "additionalProperties": false,
          "properties": { "patterns": { "$ref": "#/definitions/stringList" } }
        },
        "release": { "type": "object", "additionalProperties": false, "properties": {} },
        "manual": {
          "type": "object", "additionalProperties": false,
          "properties": { "inputs": { "type": "object", "additionalProperties": { "type": "string" } } }
        },
        "upstream": {
          "type": "object", "additionalProperties": false,
          "properties": { "repositories": { "$ref": "#/definitions/stringList" } }
        },
        "schedule": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["cron"],
            "properties": {
              "cron": { "type": "string", "pattern": "^\\S+ \\S+ \\S+ \\S+ \\S+$" },
              "branch": { "type": "string" }
            }
          }
        }
      }
    },
    "refFilter": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "branches": { "$ref": "#/definitions/stringList" },
        "paths": { "$ref": "#/definitions/stringList" }
      }
    },
    "when": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "events": { "type": "array", "items": { "enum": ["push", "pull_request", "tag", "release", "schedule", "manual", "upstream"] }, "uniqueItems": true },
        "branches": { "$ref": "#/definitions/stringList" },
        "tags": { "$ref": "#/definitions/stringList" }
      }
    },
    "concurrency": {
      "type": "object", "additionalProperties": false, "required": ["group"],
      "properties": {
        "group": { "type": "string", "minLength": 1, "maxLength": 200 },
        "cancel_in_progress": { "type": "boolean" }
      }
    },
    "jobFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": { "$ref": "#/definitions/identifier" },
        "name": { "type": "string", "maxLength": 200 },
        "image": { "type": "string", "minLength": 1 },
        "requires": { "type": "array", "items": { "$ref": "#/definitions/capability" }, "uniqueItems": true, "minItems": 1 },
        "needs": { "type": "array", "items": { "$ref": "#/definitions/identifier" }, "uniqueItems": true },
        "when": { "$ref": "#/definitions/when" },
        "matrix": {
          "type": "object", "maxProperties": 4,
          "propertyNames": { "$ref": "#/definitions/identifier" },
          "additionalProperties": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": ["string", "number", "boolean"] } }
        },
        "network": { "enum": ["none", "egress"] },
        "resources": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "cpus": { "type": "number", "minimum": 0.25, "maximum": 16 },
            "memory_mb": { "type": "integer", "minimum": 64, "maximum": 65536 },
            "disk_mb": { "type": "integer", "minimum": 64, "maximum": 262144 },
            "pids": { "type": "integer", "minimum": 16, "maximum": 32768 }
          }
        },
        "timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 360 },
        "retry": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
            "on": { "type": "array", "items": { "enum": ["infrastructure", "timeout", "failure"] }, "uniqueItems": true }
          }
        },
        "env": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        },
        "secrets": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }, "uniqueItems": true },
        "permissions": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "release": { "type": "boolean" },
            "deploy": { "type": "boolean" }
          }
        },
        "approval": {
          "type": "object", "additionalProperties": false, "required": ["required"],
          "properties": {
            "required": { "type": "boolean" },
            "approvers": { "$ref": "#/definitions/stringList" }
          }
        },
        "cache": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "path"],
            "properties": {
              "name": { "$ref": "#/definitions/identifier" },
              "path": { "type": "string", "pattern": "^/" },
              "key_files": { "$ref": "#/definitions/stringList" }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "path"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$" },
              "path": { "type": "string", "minLength": 1 },
              "retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 }
            }
          }
        },
        "steps": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["run"],
            "properties": {
              "name": { "type": "string", "maxLength": 200 },
              "run": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "job": {
      "allOf": [{ "$ref": "#/definitions/jobFields" }]
    }
  }
}
