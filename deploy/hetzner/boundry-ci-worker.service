# Boundry CI Linux worker on the shared host. Installed once by the operator (approval required);
# upgrades never edit this file: `boundry-ci deploy apply` flips /opt/boundry-ci/active and restarts the unit.
#
# Runs as the unprivileged `bci-worker` account and drives ROOTLESS Podman as that account: no Docker
# socket, no root daemon, job containers live in bci-worker's user namespace. Prerequisites (approval
# required, checked by ci-preflight.sh): podman, uidmap, passt or slirp4netns, fuse-overlayfs, a subuid/
# subgid range for bci-worker, `loginctl enable-linger bci-worker` (so /run/user/<uid> exists without a login).
[Unit]
Description=Boundry CI worker
After=network-online.target
Wants=network-online.target

[Service]
User=bci-worker
Group=bci-worker
# Non-secret settings rendered per release; the token is a 0400 file owned by bci-worker.
EnvironmentFile=/opt/boundry-ci/active/worker.env
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStart=/opt/boundry-ci/active/runtime/node /opt/boundry-ci/active/app/bin/boundry-ci.ts worker
# SIGTERM = stop leasing, finish the job in progress, exit. A job longer than this is cut off and its
# lease expires; the control plane then retries or fails it (never left running).
KillSignal=SIGTERM
TimeoutStopSec=600
Restart=always
RestartSec=5
# Contain the worker and every rootless container it starts under the CI ceiling.
Slice=boundry-ci.slice
Delegate=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/boundry-ci/work /home/bci-worker/.local/share/containers /run/user
PrivateTmp=yes
NoNewPrivileges=no
# (newuidmap/newgidmap are setuid helpers rootless Podman needs; NoNewPrivileges=yes would break them.)

[Install]
WantedBy=multi-user.target
